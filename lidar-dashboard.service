[Unit]
Description=LiDAR Navigation Dashboard (HTTP Server)
After=network.target lidar-nav.service
Wants=lidar-nav.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/research
ExecStart=/home/admin/research/venv/bin/python3 -m http.server 8080
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
